{
  "version": 2,
  "designStyle": "carbon",
  "designStyles": {
    "lacuna": {
      "bar": {
        "centerAnchor": "lacuna.clock",
        "layout": {
          "left": ["lacuna.menu-button"],
          "center": [
            {
              "id": "lacuna.clock",
              "futureMetadata": {
                "role": "time",
                "weights": [1, 2, 3]
              }
            }
          ],
          "right": []
        },
        "futurePresetField": true
      }
    },
    "omarchy": {},
    "material": {}
  },
  "colorProfile": "semantic",
  "compact": false,
  "barSizeMode": "theme",
  "quickLaunchLayout": "grid",
  "dailyLaunchLayout": "list",
  "shortcutsLayout": "grid",
  "controlsLayout": "grid",
  "barSizeSnapshot": {
    "themeName": "fixture-theme",
    "sizeHorizontal": 30,
    "sizeVertical": 32,
    "futureSnapshotField": { "keep": true }
  },
  "sizeTransition": {
    "holdCompact": false,
    "holdUntil": 0,
    "futureTransitionField": [1, 2, 3]
  },
  "customQuickLaunchApps": [
    "firefox.desktop",
    "org.wezfurlong.wezterm.desktop",
    "code.desktop"
  ],
  "customQuickLaunchNames": {
    "firefox.desktop": "Browser",
    "org.wezfurlong.wezterm.desktop": "Terminal",
    "code.desktop": "Editor"
  },
  "preferredApps": {
    "files": "org.gnome.Nautilus.desktop",
    "editor": "code.desktop",
    "email": "thunderbird.desktop",
    "discord": "vesktop.desktop",
    "futureRole": { "desktopId": "future.desktop" }
  },
  "power": {
    "instantRestart": false,
    "futurePowerField": { "keep": true }
  },
  "shellSettings": {
    "surface": "flyout",
    "futureShellField": ["keep"]
  },
  "mediaProviders": {
    "youtube": {
      "enabled": true,
      "cookiesFromBrowser": "firefox",
      "cookiesFile": "",
      "futureAuthField": { "keep": true }
    },
    "jellyfin": {
      "enabled": true,
      "serverUrl": "https://jellyfin.example",
      "apiKey": "fixture-api-key",
      "userId": "fixture-user",
      "preferredAudioLanguage": "English",
      "futurePlaybackField": ["keep"]
    },
    "futureProvider": { "enabled": true, "endpoint": "future" }
  },
  "mediaPlayer": {
    "presentationMode": "background",
    "videoQuality": "stable",
    "providerFilter": "jellyfin",
    "futurePlayerField": { "keep": true }
  },
  "sidebar": {
    "defaultMode": "rail",
    "collapsed": true,
    "exclusive": false,
    "connectorPieces": false,
    "cornerPieces": false,
    "monitorPolicy": "pinned",
    "monitorNames": ["DP-1", "DP-2"],
    "autoHide": {
      "enabled": true,
      "hotZoneWidth": 4,
      "revealDelayMs": 140,
      "hideDelayMs": 420,
      "futureAutoHideField": { "keep": true }
    },
    "futureSidebarField": { "keep": true }
  },
    "backgroundEffects": {
        "enabled": true,
        "foregroundOverlay": false,
        "opacity": 0.92,
        "activeEffect": "auroraDrift",
        "effects": {
            "trackingLines": {
                "enabled": true
            },
            "filmGrain": {
                "enabled": true,
                "intensity": 0.42,
                "speed": 1.1,
                "grainCount": 220,
                "grainSize": 1.6,
                "accentBlend": 0.25,
                "futureTuningField": { "keep": true }
            },
            "auroraDrift": {
                "enabled": true
            },
      "rainfall": {
        "enabled": true
      },
      "cinematicLight": {
        "enabled": true
      },
      "godRays": {
        "enabled": true
      },
      "crt": {
        "enabled": true
      },
      "futureEffect": {
        "enabled": true,
        "futureEffectField": { "keep": true }
      }
    },
    "futureEffectsField": ["keep"]
  },
  "backgroundVignette": {
    "enabled": true,
    "intensity": 0.85,
    "ignoreBackgroundAnimationLayer": false,
    "futureVignetteField": { "keep": true }
  },
  "frame": {
    "mode": "fullframe",
    "reserveMode": "comfort",
    "shadow": true,
    "border": true,
    "moldingPieces": true,
    "roundedContentCorners": true,
    "thickness": 10,
    "radius": 16,
    "shadowDirection": "bottom_right",
    "shadowOffsetX": 2,
    "shadowOffsetY": 3,
    "futureFrameField": { "keep": true }
  },
  "barPresentation": {
    "portraitSplit": false,
    "futurePresentationField": {
      "keep": true
    }
  }
}
