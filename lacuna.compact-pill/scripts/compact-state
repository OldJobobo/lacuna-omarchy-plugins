#!/usr/bin/env python3

import fcntl
import json
import os
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager
from pathlib import Path


HOME = Path.home()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
SETTINGS_PATH = CONFIG_HOME / "omarchy" / "lacuna" / "settings.json"
SETTINGS_LOCK_PATH = SETTINGS_PATH.with_name("settings.lock")
BAR_SIZE_STATE = CONFIG_HOME / "omarchy" / "plugins" / "lacuna.bar-size-pill" / "scripts" / "bar-size-state"


def load_settings():
    if not SETTINGS_PATH.exists():
        return {"version": 1, "colorProfile": "semantic", "compact": False, "barSizeMode": "theme", "sizeTransition": {"holdCompact": False, "holdUntil": 0}, "sidebar": {"collapsed": False, "exclusive": True, "cornerPieces": True}}
    try:
        data = json.loads(SETTINGS_PATH.read_text(encoding="utf-8"))
    except Exception:
        data = {}
    if not isinstance(data, dict):
        data = {}
    data.setdefault("version", 1)
    if data.get("colorProfile") not in ("semantic", "colorful"):
        data["colorProfile"] = "semantic"
    compact_fallback = bool(data.get("compact", False))
    if data.get("barSizeMode") not in ("theme", "compact", "full"):
        data["barSizeMode"] = "compact" if compact_fallback else "full"
    data["compact"] = data["barSizeMode"] == "compact"
    sidebar = data.setdefault("sidebar", {})
    if not isinstance(sidebar, dict):
        data["sidebar"] = {"collapsed": False, "exclusive": True, "cornerPieces": True}
    else:
        sidebar.setdefault("collapsed", False)
        sidebar.setdefault("exclusive", True)
        sidebar.setdefault("cornerPieces", True)
    return data


@contextmanager
def settings_transaction():
    SETTINGS_LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(SETTINGS_LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def save_settings(data):
    merged = load_settings()
    for key in ("barSizeMode", "compact", "sizeTransition"):
        merged[key] = data.get(key)
    SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=SETTINGS_PATH.parent,
            prefix=f".{SETTINGS_PATH.name}.tmp.",
            delete=False,
        ) as stream:
            temporary = Path(stream.name)
            stream.write(json.dumps(merged, indent=2) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, SETTINGS_PATH)
        temporary = None
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    return merged


def emit(data):
    mode = data.get("barSizeMode") if data.get("barSizeMode") in ("theme", "compact", "full") else "full"
    compact = mode == "compact"
    print(json.dumps({
        "compact": compact,
        "tooltip": "<b>Lacuna Size</b><br/>Mode: " + mode,
    }, separators=(",", ":")))


def emit_from_bar_size_state(payload):
    mode = payload.get("mode") if payload.get("mode") in ("theme", "compact", "full") else "full"
    compact = mode == "compact"
    print(json.dumps({
        "compact": compact,
        "tooltip": "<b>Lacuna Size</b><br/>Mode: " + mode,
    }, separators=(",", ":")))


def delegate_to_bar_size_state(action):
    if not BAR_SIZE_STATE.exists():
        return False

    try:
        raw = subprocess.check_output([str(BAR_SIZE_STATE), action], text=True)
        payload = json.loads(raw or "{}")
    except Exception:
        return False

    emit_from_bar_size_state(payload)
    return True


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "get"
    if delegate_to_bar_size_state(action):
        return

    if action != "toggle":
        emit(load_settings())
        return

    with settings_transaction():
        data = load_settings()
        old_compact = bool(data.get("compact", False))
        data["barSizeMode"] = "full" if data.get("barSizeMode") == "compact" else "compact"
        data["compact"] = data["barSizeMode"] == "compact"
        data["sizeTransition"] = {
            "holdCompact": old_compact,
            "holdUntil": int((time.time() + 0.056) * 1000),
        }
        data = save_settings(data)
        emit(data)


if __name__ == "__main__":
    main()
